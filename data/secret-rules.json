{
  "_comment": "gitleaks 기본 규칙(https://github.com/gitleaks/gitleaks/blob/master/config/gitleaks.toml)의 부분집합 + AI 서비스 키. Group 이 있으면 해당 캡처 그룹만 비밀값으로 마스킹한다.",
  "Rules": [
    { "Id": "anthropic",        "Name": "Anthropic API Key",          "Severity": "CAT I",  "Regex": "sk-ant-(?:api|admin|oat)\\d{2}-[A-Za-z0-9_\\-]{80,}" },
    { "Id": "openai",           "Name": "OpenAI API Key",             "Severity": "CAT I",  "Regex": "\\bsk-(?:proj|svcacct|admin)-[A-Za-z0-9_\\-]{40,}|\\bsk-[A-Za-z0-9]{20}T3BlbkFJ[A-Za-z0-9]{20}\\b|\\bsk-[A-Za-z0-9]{48}\\b" },
    { "Id": "openrouter",       "Name": "OpenRouter API Key",         "Severity": "CAT I",  "Regex": "\\bsk-or-v1-[a-f0-9]{64}\\b" },
    { "Id": "google-api",       "Name": "Google/Gemini API Key",      "Severity": "CAT I",  "Regex": "\\bAIza[0-9A-Za-z_\\-]{35}\\b" },
    { "Id": "google-oauth",     "Name": "Google OAuth Client Secret", "Severity": "CAT II", "Regex": "\\bGOCSPX-[A-Za-z0-9_\\-]{28}\\b" },
    { "Id": "google-refresh",   "Name": "Google OAuth Refresh Token", "Severity": "CAT I",  "Regex": "\\b1//0[A-Za-z0-9_\\-]{60,}" },
    { "Id": "aws-akid",         "Name": "AWS Access Key ID",          "Severity": "CAT I",  "Regex": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b" },
    { "Id": "aws-secret",       "Name": "AWS Secret Access Key",      "Severity": "CAT I",  "Regex": "(?i)aws_secret_access_key\\s*[=:]\\s*[\"']?([A-Za-z0-9/+=]{40})", "Group": 1 },
    { "Id": "azure-storage",    "Name": "Azure Storage Account Key",  "Severity": "CAT I",  "Regex": "AccountKey=([A-Za-z0-9+/=]{86,88})", "Group": 1 },
    { "Id": "github-pat",       "Name": "GitHub Token",               "Severity": "CAT I",  "Regex": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}\\b|\\bgithub_pat_[A-Za-z0-9_]{82}\\b" },
    { "Id": "gitlab-pat",       "Name": "GitLab Token",               "Severity": "CAT I",  "Regex": "\\bglpat-[A-Za-z0-9_\\-]{20,}\\b" },
    { "Id": "slack-token",      "Name": "Slack Token",                "Severity": "CAT I",  "Regex": "\\bxox[baprs]-[A-Za-z0-9-]{10,}" },
    { "Id": "slack-webhook",    "Name": "Slack Webhook URL",          "Severity": "CAT II", "Regex": "https://hooks\\.slack\\.com/services/[A-Za-z0-9/_]{20,}" },
    { "Id": "discord-webhook",  "Name": "Discord Webhook URL",        "Severity": "CAT II", "Regex": "https://(?:ptb\\.|canary\\.)?discord(?:app)?\\.com/api/webhooks/\\d+/[A-Za-z0-9_\\-]{60,}" },
    { "Id": "telegram-bot",     "Name": "Telegram Bot Token",         "Severity": "CAT II", "Regex": "\\b\\d{8,10}:AA[A-Za-z0-9_\\-]{33}\\b" },
    { "Id": "huggingface",      "Name": "Hugging Face Token",         "Severity": "CAT I",  "Regex": "\\bhf_[A-Za-z0-9]{34,}\\b" },
    { "Id": "notion",           "Name": "Notion Integration Token",   "Severity": "CAT I",  "Regex": "\\bntn_[A-Za-z0-9]{40,}\\b|\\bsecret_[A-Za-z0-9]{43}\\b" },
    { "Id": "stripe",           "Name": "Stripe Live Key",            "Severity": "CAT I",  "Regex": "\\b(?:sk|rk)_live_[A-Za-z0-9]{24,}\\b" },
    { "Id": "supabase-pat",     "Name": "Supabase Access Token",      "Severity": "CAT I",  "Regex": "\\bsbp_[a-f0-9]{40}\\b|\\bsb_secret_[A-Za-z0-9_\\-]{20,}" },
    { "Id": "groq",             "Name": "Groq API Key",               "Severity": "CAT I",  "Regex": "\\bgsk_[A-Za-z0-9]{52}\\b" },
    { "Id": "xai",              "Name": "xAI API Key",                "Severity": "CAT I",  "Regex": "\\bxai-[A-Za-z0-9]{80}\\b" },
    { "Id": "perplexity",       "Name": "Perplexity API Key",         "Severity": "CAT I",  "Regex": "\\bpplx-[A-Za-z0-9]{48}\\b" },
    { "Id": "replicate",        "Name": "Replicate API Token",        "Severity": "CAT I",  "Regex": "\\br8_[A-Za-z0-9]{37}\\b" },
    { "Id": "npm-token",        "Name": "npm Access Token",           "Severity": "CAT I",  "Regex": "\\bnpm_[A-Za-z0-9]{36}\\b" },
    { "Id": "pypi-token",       "Name": "PyPI Upload Token",          "Severity": "CAT I",  "Regex": "\\bpypi-AgEIcHlwaS5vcmc[A-Za-z0-9_\\-]{50,}" },
    { "Id": "sendgrid",         "Name": "SendGrid API Key",           "Severity": "CAT I",  "Regex": "\\bSG\\.[A-Za-z0-9_\\-]{22}\\.[A-Za-z0-9_\\-]{43}\\b" },
    { "Id": "jwt",              "Name": "JWT",                        "Severity": "CAT III","Regex": "\\beyJ[A-Za-z0-9_\\-]{10,}\\.eyJ[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,}" },
    { "Id": "private-key",      "Name": "Private Key (PEM)",          "Severity": "CAT I",  "Regex": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY(?: BLOCK)?-----(?:\\s|\\\\n)*(?:[\\w-]+:[^\\r\\n]*\\r?\\n\\s*)*(?:[A-Za-z0-9+/=\\r\\n]|\\\\n){64,}" },
    { "Id": "url-credential",   "Name": "URL 내 자격증명",             "Severity": "CAT II", "Regex": "\\b[a-z][a-z0-9+.\\-]{1,15}://[^\\s:/@\"'<>]{1,64}:([^\\s:/@\"'<>]{6,128})@[A-Za-z0-9.\\-]+", "Group": 1 },
    { "Id": "docker-auth",      "Name": "Docker 레지스트리 auth",      "Severity": "CAT II", "Regex": "\"auth\"\\s*:\\s*\"([A-Za-z0-9+/=]{16,})\"", "Group": 1 },
    { "Id": "generic",          "Name": "일반 키/토큰 할당",           "Severity": "CAT III","Regex": "(?i)\\b[A-Z0-9_.\\-]*(?:api[_\\-]?key|secret|token|passwd|password|access[_\\-]?key)[A-Z0-9_.\\-]*[\"']?\\s*[=:]\\s*[\"']?([^\\s\"'`,;<>]{12,})", "Group": 1, "MinEntropy": 3.5 }
  ],
  "PlaceholderRegex": "(?i)^(x{4,}|\\*{4,}|your[_\\-]|<|\\$\\{|\\{\\{|example|changeme|placeholder|dummy|test|sample|redacted|none|null|true|false|undefined)",
  "SkipDirs": [ "node_modules", ".git", "site-packages", "dist-packages", "__pycache__", ".venv", "venv", ".tox", ".mypy_cache", ".pytest_cache",
                ".cache", ".npm", ".nuget", ".gradle", ".m2", ".rustup", ".cargo\\registry", ".vscode-server", "go\\pkg", "bower_components",
                "AppData\\Local", ".vscode\\extensions", ".claude\\plugins", "AppData\\Roaming\\Code\\User\\History", "AppData\\Roaming\\Code\\logs", "AppData\\Roaming\\npm", "build", "dist", ".next", "target", "AppData\\Local\\Google\\Chrome\\User Data",
                "AppData\\Local\\Microsoft\\Edge\\User Data", "AppData\\Local\\Mozilla", "AppData\\Roaming\\Mozilla", "AppData\\Local\\pip\\cache",
                "AppData\\Local\\Programs", "AppData\\Roaming\\Code\\Cache", "AppData\\Roaming\\Code\\CachedData", "AppData\\Roaming\\Code\\User\\workspaceStorage",
                "AppData\\Local\\CrashDumps", "AppData\\LocalLow" ],
  "TextExtensions": [ "", ".txt", ".md", ".json", ".jsonc", ".json5", ".yaml", ".yml", ".toml", ".ini", ".cfg", ".conf", ".config", ".env", ".properties",
                      ".xml", ".ps1", ".psm1", ".psd1", ".bat", ".cmd", ".sh", ".bash", ".zsh", ".py", ".ipynb", ".js", ".mjs", ".cjs", ".ts", ".tsx", ".jsx",
                      ".java", ".kt", ".go", ".rs", ".rb", ".php", ".cs", ".c", ".cpp", ".h", ".sql", ".log", ".csv", ".tf", ".tfvars", ".hcl",
                      ".pem", ".key", ".ppk", ".npmrc", ".pypirc", ".netrc", ".gitconfig", ".git-credentials", ".htpasswd", ".html", ".htm", ".vue", ".svelte",
                      ".dart", ".swift", ".gradle", ".kts", ".r", ".lua", ".pl", ".bak", ".old", ".orig", ".local", ".example", ".sample", ".tpl" ],
  "GenericExtensions": [ ".env", ".json", ".jsonc", ".json5", ".yaml", ".yml", ".toml", ".ini", ".cfg", ".conf", ".config", ".properties", ".tfvars", ".npmrc", ".pypirc", ".netrc", ".local", ".ps1", ".bat", ".cmd", ".sh" ],
  "CertFileExtensions": [ ".pfx", ".p12" ],
  "MaxFileBytes": 5242880
}
